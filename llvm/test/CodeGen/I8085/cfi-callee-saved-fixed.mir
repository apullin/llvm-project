# RUN: llc -mtriple=i8085-unknown-elf -run-pass=i8085-frame-analyzer,prologepilog -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @cfi_callee_saved_fixed() {
  entry:
    ret void
  }
...

---
name:            cfi_callee_saved_fixed
tracksRegLiveness: true
liveins:
  - { reg: '$de' }
frameInfo:
  hasCalls:        false
  stackSize:       6
  maxAlignment:    1
  adjustsStack:    true
stack:
  - { id: 0, name: '', type: default, offset: -6, size: 4, alignment: 1 }
body:             |
  bb.0.entry:
    liveins: $de
    ; CHECK-LABEL: name: cfi_callee_saved_fixed
    ; CHECK: frame-setup CFI_INSTRUCTION adjust_cfa_offset 2
    ; CHECK: frame-setup CFI_INSTRUCTION adjust_cfa_offset 4
    ; CHECK: frame-setup CFI_INSTRUCTION offset $de, -{{[0-9]+}}
    ; CHECK: frame-destroy CFI_INSTRUCTION adjust_cfa_offset -2
    ; CHECK: frame-destroy CFI_INSTRUCTION adjust_cfa_offset {{(-4|4294967292)}}
    ; CHECK: frame-destroy CFI_INSTRUCTION restore $de
    $hl = COPY $de
    $de = IMPLICIT_DEF
    RET
...
