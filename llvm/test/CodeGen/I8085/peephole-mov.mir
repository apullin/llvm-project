# RUN: llc -O0 -run-pass=i8085-expand-pseudo %s -o - | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @test() { ret void }
...

---
name:            test
registers:
  - { id: 0, class: gr8 }
body:             |
  bb.0:
    ; CHECK-LABEL: test
    ; CHECK-NOT: MOV
    ; CHECK: RET
    %0 = IMPLICIT_DEF
    %0 = MOV %0
    RET
...
