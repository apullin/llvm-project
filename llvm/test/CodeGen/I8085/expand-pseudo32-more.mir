# RUN: llc -O0 -run-pass=i8085-expand-pseudo32 %s -o - | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @trunc32to16_bc() { ret void }
  define void @trunc32to8_c() { ret void }
  define void @zext16to32_iax() { ret void }
  define void @sext16to32_iax() { ret void }
  define void @zext8to32_iax() { ret void }
  define void @sext8to32_iax() { ret void }
  define void @load32_addr_content_bc() { ret void }
  define void @store32_addr_content_bc() { ret void }
  define void @rl32_iax() { ret void }
  define void @rr32_iax() { ret void }
  define void @asr32_iax() { ret void }
  define void @load32_offset_sp() { ret void }
  define void @store32_offset_sp() { ret void }
...

---
name:            trunc32to16_bc
body:             |
  bb.0:
    liveins: $iax
    ; CHECK-LABEL: name:            trunc32to16_bc
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $c = MOV_FROM_M
    ; CHECK: $hl = LXI 1
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $b = MOV_FROM_M
    $bc = TRUNC32TO16 $iax
    RET
...

---
name:            trunc32to8_c
body:             |
  bb.0:
    liveins: $iax
    ; CHECK-LABEL: name:            trunc32to8_c
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $c = MOV_FROM_M
    $c = TRUNC32TO8 $iax
    RET
...

---
name:            zext16to32_iax
body:             |
  bb.0:
    liveins: $bc
    ; CHECK-LABEL: name:            zext16to32_iax
    ; CHECK: $hl = LXI 3
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MVI_M 0
    ; CHECK: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MVI_M 0
    ; CHECK: $hl = LXI 1
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $b
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $c
    $iax = ZEXT16TO32 $bc
    RET
...

---
name:            sext16to32_iax
body:             |
  bb.0:
    liveins: $bc
    ; CHECK-LABEL: name:            sext16to32_iax
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $c
    ; CHECK: $hl = LXI 1
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $b
    ; CHECK: ADI 128
    ; CHECK: SBB $a
    ; CHECK: $hl = LXI 3
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    ; CHECK: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    $iax = SEXT16TO32 $bc
    RET
...

---
name:            zext8to32_iax
body:             |
  bb.0:
    liveins: $c
    ; CHECK-LABEL: name:            zext8to32_iax
    ; CHECK: $hl = LXI 3
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MVI_M 0
    ; CHECK: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MVI_M 0
    ; CHECK: $hl = LXI 1
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MVI_M 0
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $c
    $iax = ZEXT8TO32 $c
    RET
...

---
name:            sext8to32_iax
body:             |
  bb.0:
    liveins: $c
    ; CHECK-LABEL: name:            sext8to32_iax
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $c
    ; CHECK: ADI 128
    ; CHECK: SBB $a
    ; CHECK: $hl = LXI 3
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    ; CHECK: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    ; CHECK: $hl = LXI 1
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    $iax = SEXT8TO32 $c
    RET
...

---
name:            load32_addr_content_bc
body:             |
  bb.0:
    liveins: $bc, $sp
    ; CHECK-LABEL: name:            load32_addr_content_bc
    ; CHECK: $h = MOV $b
    ; CHECK-NEXT: $l = MOV $c
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    $iax = LOAD_32_ADDR_CONTENT $bc, implicit $sp
    RET
...

---
name:            store32_addr_content_bc
body:             |
  bb.0:
    liveins: $bc, $iax, $sp
    ; CHECK-LABEL: name:            store32_addr_content_bc
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $h = MOV $b
    ; CHECK-NEXT: $l = MOV $c
    ; CHECK-NEXT: MOV_M $a
    STORE_32_ADDR_CONTENT $bc, $iax, implicit $sp
    RET
...

---
name:            rl32_iax
body:             |
  bb.0:
    liveins: $iax
    ; CHECK-LABEL: name:            rl32_iax
    ; CHECK: XRA $a
    ; CHECK: RAL
    ; CHECK: ANI 254
    $iax = RL_32 $iax, implicit-def $sreg, implicit-def $a, implicit $a
    RET
...

---
name:            rr32_iax
body:             |
  bb.0:
    liveins: $iax
    ; CHECK-LABEL: name:            rr32_iax
    ; CHECK: XRA $a
    ; CHECK: RAR
    ; CHECK: ANI 127
    $iax = RR_32 $iax, implicit-def $sreg, implicit-def $a, implicit $a
    RET
...

---
name:            asr32_iax
body:             |
  bb.0:
    liveins: $iax
    ; CHECK-LABEL: name:            asr32_iax
    ; CHECK: RLC
    ; CHECK: RAR
    $iax = ASR_32 $iax, implicit-def $sreg, implicit-def $a, implicit $a
    RET
...

---
name:            load32_offset_sp
body:             |
  bb.0:
    liveins: $sp
    ; CHECK-LABEL: name:            load32_offset_sp
    ; CHECK: $hl = LXI 8
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    $iax = LOAD_32_OFFSET_WITH_SP 8, implicit $sp
    RET
...

---
name:            store32_offset_sp
body:             |
  bb.0:
    liveins: $sp, $iax
    ; CHECK-LABEL: name:            store32_offset_sp
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $hl = LXI 12
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    ; CHECK: $hl = LXI 1
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $hl = LXI 13
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    ; CHECK: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $hl = LXI 14
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    ; CHECK: $hl = LXI 3
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV_FROM_M
    ; CHECK: $hl = LXI 15
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $a
    STORE_32_AT_OFFSET_WITH_SP $iax, 12, implicit $sp
    RET
...
