define i16 @argpass16(i16,i16,i16) #0  {
; CHECK-LABEL: argpass16:
; CHECK:         .cfi_startproc
; CHECK-NEXT:  LBB0_0:
; CHECK-NEXT:    LXI H, 7
; CHECK-NEXT:    DAD SP
; CHECK-NEXT:    MOV B, M
; CHECK-NEXT:    DCX H
; CHECK-NEXT:    MOV C, M
; CHECK-NEXT:    RET

  %4 = alloca i16, align 1
  store i16 %2, i16* %4, align 1
  %5 = load i16, i16* %4, align 1
  ret i16 %5
}


define i8 @argpass8(i8,i8,i8)  {
