# RUN: llc -mtriple=i8085-unknown-elf -run-pass=prologepilog -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @cfi_callee_saved(i16 %x) {
  entry:
    ret void
  }
...

---
name:            cfi_callee_saved
tracksRegLiveness: true
liveins:
  - { reg: '$de' }
frameInfo:
  hasCalls:        true
  maxAlignment:    1
  adjustsStack:    true
stack:
  - { id: 0, type: variable-sized, alignment: 1 }
body:             |
  bb.0.entry:
    liveins: $de
    ; CHECK-LABEL: name: cfi_callee_saved
    ; CHECK-NOT: CFI_INSTRUCTION
    ; CHECK: SPHL
    ; CHECK: RET
    RET implicit $sp, implicit-def $sp
...
