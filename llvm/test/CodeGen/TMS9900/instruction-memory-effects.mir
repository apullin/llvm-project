# RUN: llc -mtriple=tms9900 -run-pass=dead-mi-elimination \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

# Patternless instruction definitions must expose their real effects. A dead
# status-register read may be removed. Loads remain conservatively observable
# to Machine DCE, stores must remain, and auto-increment must retain its
# unmodeled address-register update until that writeback is explicit.

---
name:            instruction_memory_effects
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $r1, $r2
    %0:gr16 = STST implicit $st
    dead $r3 = Aim $r1, implicit-def dead $st
    Cmi $r1, $r2, implicit-def dead $st
    Ami $r1, $r2, implicit-def dead $st
    Cpim $r1, $r2, implicit-def dead $st
    RET

# CHECK-LABEL: name: instruction_memory_effects
# CHECK-NOT: STST
# CHECK: dead $r3 = Aim $r1, implicit-def dead $st
# CHECK-NEXT: Cmi $r1, $r2, implicit-def dead $st
# CHECK: Ami $r1, $r2, implicit-def dead $st
# CHECK-NEXT: Cpim $r1, $r2, implicit-def dead $st
...
