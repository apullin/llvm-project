# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole %s -o - | FileCheck %s

--- |
  @foo = external global i16
  define void @postinc() {
    ret void
  }
  define void @postinc_live_st() {
    ret void
  }
...
---
name: postinc
tracksRegLiveness: true
body: |
  bb.0:
    renamable $r1 = IMPLICIT_DEF
    renamable $r2 = IMPLICIT_DEF
    renamable $r3 = IMPLICIT_DEF
    renamable $r4 = IMPLICIT_DEF
    renamable $r5 = IMPLICIT_DEF
    renamable $r6 = IMPLICIT_DEF

    renamable $r0 = MOVim $r1, implicit-def dead $st :: (load (s16) from @foo)
    renamable $r1 = AI killed $r1, 2, implicit-def dead $st

    MOVmi $r2, killed $r3, implicit-def dead $st
    renamable $r2 = INCTr killed $r2, implicit-def dead $st

    renamable $r4 = MOVBim $r5, implicit-def dead $st
    renamable $r5 = AI killed $r5, 1, implicit-def dead $st

    MOVBmi $r6, killed $r0, implicit-def dead $st
    renamable $r6 = INCr killed $r6, implicit-def dead $st

    RET
...

# CHECK-LABEL: name: postinc
# CHECK: MOVpim{{.*}}implicit-def dead $st :: (load (s16) from @foo)
# CHECK: MOVmpi
# CHECK: MOVBpim
# CHECK: MOVBmpi

# Folding would replace the final AI status with the preceding MOV status.
# Keep the original pair when a branch observes the increment result.
---
name: postinc_live_st
tracksRegLiveness: true
body: |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $r0, $r1
    renamable $r0 = MOVim $r1, implicit-def dead $st
    renamable $r1 = AI killed $r1, 2, implicit-def $st
    JEQ %bb.1, implicit $st

  bb.2:
    RET

  bb.1:
    RET
...

# CHECK-LABEL: name: postinc_live_st
# CHECK: MOVim
# CHECK-NEXT: $r1 = INCTr killed $r1, implicit-def $st
# CHECK-NEXT: JEQ
# CHECK-NOT: MOVpim
