# RUN: llc -mtriple=tms9900 -run-pass=tms9900-peephole -verify-machineinstrs %s -o - | FileCheck %s

# Replacing a shift by eight with SWPB must preserve flags on the tied source
# operand. Dropping `undef` creates an undefined physical-register read.

---
name:            swpb_undef_source
tracksRegLiveness: true
body:             |
  bb.0:
    $r0 = SLAri undef $r0(tied-def 0), 8, implicit-def dead $st
    $r0 = ANDI killed $r0(tied-def 0), -256, implicit-def dead $st
    RET

# CHECK-LABEL: name: swpb_undef_source
# CHECK: $r0 = SWPBr undef $r0
# CHECK-NEXT: $r0 = ANDI killed $r0, -256
...
---
name:            keep_undef_self_copy
tracksRegLiveness: true
body:             |
  bb.0:
    $r0 = MOVrr undef $r0, implicit-def dead $st
    $r1 = MOVrr killed $r0, implicit-def dead $st
    RET

# CHECK-LABEL: name: keep_undef_self_copy
# CHECK: $r0 = MOVrr undef $r0, implicit-def dead $st
# CHECK-NEXT: $r1 = MOVrr killed $r0, implicit-def dead $st
...
