# RUN: llc -run-pass=i8085-expand-pseudo -verify-machineinstrs %s -o - | FileCheck %s
--- |
  target triple = "i8085-unknown-elf"
  define void @neither() { ret void }
  define void @accumulator() { ret void }
  define void @flags() { ret void }
  define void @both() { ret void }
...
---
name: neither
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sp
    ; CHECK-LABEL: name: neither
    ; CHECK-NOT: PUSH
    ; CHECK: $hl = LXI 16
    ; CHECK-NOT: POP
    ; CHECK: RET
    $bc = FRMIDX_REALIGNED $sp, 16, 6, implicit-def $sreg, implicit-def $a, implicit-def $h, implicit-def $l
    RET implicit $bc, implicit $sp, implicit-def $sp
...
---
name: accumulator
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sp, $a
    ; CHECK-LABEL: name: accumulator
    ; CHECK: PUSH undef $psw, implicit-def $sp, implicit $sp, implicit $a
    ; CHECK: $hl = LXI 18
    ; CHECK: $psw = POP
    ; CHECK: RET
    $bc = FRMIDX_REALIGNED $sp, 16, 6, implicit-def $sreg, implicit-def $a, implicit-def $h, implicit-def $l
    RET implicit $bc, implicit $a, implicit $sp, implicit-def $sp
...
---
name: flags
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sp, $sreg
    ; CHECK-LABEL: name: flags
    ; CHECK: PUSH undef $psw, implicit-def $sp, implicit $sp, implicit $sreg
    ; CHECK: $hl = LXI 18
    ; CHECK: $psw = POP
    ; CHECK: RET
    $bc = FRMIDX_REALIGNED $sp, 16, 6, implicit-def $sreg, implicit-def $a, implicit-def $h, implicit-def $l
    RET implicit $bc, implicit $sreg, implicit $sp, implicit-def $sp
...
---
name: both
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $sp, $a, $sreg
    ; CHECK-LABEL: name: both
    ; CHECK: PUSH $psw
    ; CHECK: $hl = LXI 18
    ; CHECK: $psw = POP
    ; CHECK: RET
    $bc = FRMIDX_REALIGNED $sp, 16, 6, implicit-def $sreg, implicit-def $a, implicit-def $h, implicit-def $l
    RET implicit $bc, implicit $a, implicit $sreg, implicit $sp, implicit-def $sp
...
