# RUN: llc -mtriple=i8085-unknown-elf -run-pass=prologepilog -verify-machineinstrs -o - %s | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @cfi_callee_saved_frameless() {
  entry:
    ret void
  }
...

---
name:            cfi_callee_saved_frameless
tracksRegLiveness: true
liveins:
  - { reg: '$hl' }
body:             |
  bb.0.entry:
    liveins: $hl
    ; CHECK-LABEL: name: cfi_callee_saved_frameless
    ; CHECK: frame-setup CFI_INSTRUCTION adjust_cfa_offset 2
    ; CHECK: frame-setup CFI_INSTRUCTION offset $de, -{{[0-9]+}}
    ; CHECK: frame-destroy CFI_INSTRUCTION adjust_cfa_offset -2
    ; CHECK: frame-destroy CFI_INSTRUCTION restore $de
    $de = COPY $hl
    RET
...
