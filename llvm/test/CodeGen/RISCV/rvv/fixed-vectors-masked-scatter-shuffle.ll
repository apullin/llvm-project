; A scatter whose constant indices permute all lanes becomes a shuffle and a
; unit-stride store. The shuffle must use the inverse of the index permutation.

; Lane i is stored to element idx[i] = {0,4,1,5,2,6,3,7}, so memory receives
; the de-interleaved value {v0,v2,v4,v6,v1,v3,v5,v7}: the vrgather indices in
; .LCPI0_0 are the inverse permutation.
; CHECK-LABEL: .LCPI0_0:
; CHECK-NEXT:    .half 0 # 0x0
; CHECK-NEXT:    .half 2 # 0x2
; CHECK-NEXT:    .half 4 # 0x4
; CHECK-NEXT:    .half 6 # 0x6
; CHECK-NEXT:    .half 1 # 0x1
; CHECK-NEXT:    .half 3 # 0x3
; CHECK-NEXT:    .half 5 # 0x5
; CHECK-NEXT:    .half 7 # 0x7
define void @mscatter_shuffle_deinterleave(<8 x i16> %val, ptr %base) {
; CHECK-LABEL: mscatter_shuffle_deinterleave:
; CHECK:       # %bb.0:
; CHECK-NEXT:    lui a1, %hi(.LCPI0_0)
; CHECK-NEXT:    addi a1, a1, %lo(.LCPI0_0)
; CHECK-NEXT:    vsetivli zero, 8, e16, m1, ta, ma
; CHECK-NEXT:    vle16.v v9, (a1)
; CHECK-NEXT:    vrgather.vv v10, v8, v9
; CHECK-NEXT:    vse16.v v10, (a0)
; CHECK-NEXT:    ret
  %ptrs = getelementptr inbounds i16, ptr %base, <8 x i64> <i64 0, i64 4, i64 1, i64 5, i64 2, i64 6, i64 3, i64 7>
  call void @llvm.masked.scatter.v8i16.v8p0(<8 x i16> %val, <8 x ptr> %ptrs, i32 2, <8 x i1> splat (i1 true))
  ret void
}

; Lane i is stored to element i+1 (mod 8), so memory receives {v7,v0,...,v6}.
define void @mscatter_shuffle_rotate_by_one(<8 x i16> %val, ptr %base) {
; CHECK-LABEL: mscatter_shuffle_rotate_by_one:
; CHECK:       # %bb.0:
; CHECK-NEXT:    vsetivli zero, 8, e16, m1, ta, ma
; CHECK-NEXT:    vslidedown.vi v9, v8, 7
; CHECK-NEXT:    vslideup.vi v9, v8, 1
; CHECK-NEXT:    vse16.v v9, (a0)
; CHECK-NEXT:    ret
  %ptrs = getelementptr inbounds i16, ptr %base, <8 x i64> <i64 1, i64 2, i64 3, i64 4, i64 5, i64 6, i64 7, i64 0>
  call void @llvm.masked.scatter.v8i16.v8p0(<8 x i16> %val, <8 x ptr> %ptrs, i32 2, <8 x i1> splat (i1 true))
