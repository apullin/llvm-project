# RUN: llc -O0 -mtriple=i8085-unknown-elf -run-pass=i8085-expand-pseudo32 \
# RUN:   -verify-machineinstrs %s -o - | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @store32_preserves_a() { ret void }
  define void @store32_bc_base() { ret void }
...

---
name:            store32_preserves_a
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $a, $b, $iax, $sp
    ; B is live after the store, forcing the accumulator-based fallback.
    ; CHECK-LABEL: name: store32_preserves_a
    ; CHECK: PUSH $psw
    ; CHECK: MOV_M $a
    ; CHECK: $psw = POP
    ; CHECK: $c = MOV $a
    STORE_32 $sp, 4, $iax, implicit-def dead $h, implicit-def dead $l, implicit $sp
    $c = MOV $a
    $d = MOV $b
    RET implicit $sp, implicit-def $sp
...

---
name:            store32_bc_base
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc, $iax, $sp
    ; Loading the source into BCDE here would destroy the destination address.
    ; CHECK-LABEL: name: store32_bc_base
    ; CHECK-NOT: $b = MOV_FROM_M
    ; CHECK: DAD $bc
    ; CHECK: MOV_M $a
    STORE_32 $bc, 0, $iax, implicit-def dead $h, implicit-def dead $l, implicit $sp
    RET implicit $sp, implicit-def $sp
...
