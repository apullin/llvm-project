# RUN: llc -O0 -verify-machineinstrs -run-pass=i8085-expand-pseudo %s -o - | FileCheck %s

--- |
  target triple = "i8085-unknown-elf"
  define void @load16_bc() { ret void }
  define void @load8_de() { ret void }
  define void @load16_de() { ret void }
  define void @load16_bc_self() { ret void }
  define void @load16_bc_self_preserve_hl() { ret void }
  define void @load16_scratch_bc_self() { ret void }
  define void @load16_sp_preserve_carry() { ret void }
  define void @store8_bc() { ret void }
  define void @store16_bc() { ret void }
  define void @store16_hl() { ret void }
  define void @store16_hl_hl() { ret void }
  define void @store16_hl_hl_preserve_bc() { ret void }
  define void @store16_sp_hl() { ret void }
  define void @store16_sp_hl_preserve_bc() { ret void }
  define void @store16_bc_sp() { ret void }
  define void @store16_hl_sp() { ret void }
  define void @store16_hl_sp_preserve_bc() { ret void }
  define void @store16_sp_sp() { ret void }
  define void @store16_sp_de_preserve_carry() { ret void }
  define void @store8_hl() { ret void }
  define void @frmidx_bc() { ret void }
  define void @frmidx_hl() { ret void }
...

---
name:            load16_bc
body:             |
  bb.0:
    liveins: $bc
    ; CHECK-LABEL: name:            load16_bc
    ; CHECK: LDAX $bc
    ; CHECK-NEXT: $e = MOV $a
    ; CHECK-NEXT: $bc = INX
    ; CHECK-NEXT: LDAX $bc
    ; CHECK-NEXT: $d = MOV $a
    ; CHECK-NEXT: $bc = DCX
    $de = LOAD_16_ADDR_CONTENT $bc, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            load8_de
body:             |
  bb.0:
    liveins: $de
    ; CHECK-LABEL: name:            load8_de
    ; CHECK: LDAX $de
    ; CHECK-NEXT: $c = MOV $a
    $c = LOAD_8_ADDR_CONTENT $de, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            load16_de
body:             |
  bb.0:
    liveins: $bc

    ; CHECK-LABEL: name:            load16_de
    ; CHECK: LDAX $bc
    ; CHECK-NEXT: $e = MOV $a
    ; CHECK-NEXT: $bc = INX
    ; CHECK-NEXT: LDAX $bc
    ; CHECK-NEXT: $d = MOV $a
    ; CHECK-NEXT: $bc = DCX
    $de = LOAD_16_ADDR_CONTENT $bc, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            load16_bc_self
body:             |
  bb.0:
    liveins: $bc

    ; CHECK-LABEL: name:            load16_bc_self
    ; CHECK: $h = MOV $b
    ; CHECK-NEXT: $l = MOV $c
    ; CHECK-NEXT: $c = MOV_FROM_M
    ; CHECK-NEXT: $hl = INX
    ; CHECK-NEXT: $b = MOV_FROM_M
    $bc = LOAD_16_ADDR_CONTENT $bc, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            load16_bc_self_preserve_hl
body:             |
  bb.0:
    liveins: $bc, $hl

    ; CHECK-LABEL: name:            load16_bc_self_preserve_hl
    ; CHECK: PUSH $hl
    ; CHECK: $h = MOV $b
    ; CHECK-NEXT: $l = MOV $c
    ; CHECK: $hl = POP
    ; CHECK-NEXT: $a = MOV $h
    $bc = LOAD_16_ADDR_CONTENT $bc, implicit-def $a, implicit $sp
    $a = MOV $h
    RET implicit $sp, implicit-def $sp
...

---
name:            load16_scratch_bc_self
tracksRegLiveness: true
body:             |
  bb.0:
    liveins: $bc
    ; CHECK-LABEL: name: load16_scratch_bc_self
    ; CHECK-NOT: PUSH
    ; CHECK: $h = MOV $b
    ; CHECK-NEXT: $l = MOV $c
    ; CHECK-NEXT: $c = MOV_FROM_M
    ; CHECK-NEXT: $hl = INX
    ; CHECK-NEXT: $b = MOV_FROM_M
    ; CHECK-NOT: POP
    ; CHECK: RET
    $bc = LOAD_16_ADDR_CONTENT_SCRATCH $bc, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            load16_sp_preserve_carry
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $sp, $sreg
    ; CHECK-LABEL: name: load16_sp_preserve_carry
    ; CHECK: PUSH $psw
    ; CHECK-NEXT: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK: $psw = POP
    ; CHECK-NEXT: JC %bb.1, implicit $sreg
    $bc = LOAD_16_ADDR_CONTENT $sp, implicit-def $a, implicit $sp
    JC %bb.1, implicit $sreg
    JMP %bb.2

  bb.1:
    RET implicit $sp, implicit-def $sp

  bb.2:
    RET implicit $sp, implicit-def $sp
...

---
name:            store8_bc
body:             |
  bb.0:
    liveins: $bc, $c
    ; CHECK-LABEL: name:            store8_bc
    ; CHECK: $a = MOV $c
    ; CHECK-NEXT: STAX $bc
    STORE_8_ADDR_CONTENT $bc, $c, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_bc
body:             |
  bb.0:
    liveins: $bc, $de
    ; CHECK-LABEL: name:            store16_bc
    ; CHECK: $a = MOV $e
    ; CHECK-NEXT: STAX $bc
    ; CHECK-NEXT: $bc = INX
    ; CHECK-NEXT: $a = MOV $d
    ; CHECK-NEXT: STAX $bc
    ; CHECK-NEXT: $bc = DCX
    STORE_16_ADDR_CONTENT $bc, $de, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_hl
body:             |
  bb.0:
    liveins: $hl, $de

    ; CHECK-LABEL: name:            store16_hl
    ; CHECK: MOV_M $e, implicit $h, implicit $l
    ; CHECK-NEXT: $hl = INX
    ; CHECK-NEXT: MOV_M $d, implicit $h, implicit $l
    ; CHECK-NEXT: $hl = DCX
    STORE_16_ADDR_CONTENT $hl, $de, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_hl_hl
body:             |
  bb.0:
    liveins: $hl

    ; CHECK-LABEL: name: store16_hl_hl
    ; CHECK-NOT: PUSH $bc
    ; CHECK: PUSH $hl
    ; CHECK-NEXT: $bc = POP
    ; CHECK: MOV_M $c
    ; CHECK: MOV_M $b
    ; CHECK-NOT: $bc = POP
    STORE_16_ADDR_CONTENT $hl, $hl, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_hl_hl_preserve_bc
body:             |
  bb.0:
    liveins: $bc, $hl

    ; CHECK-LABEL: name: store16_hl_hl_preserve_bc
    ; CHECK: PUSH $bc
    ; CHECK-NEXT: PUSH $hl
    ; CHECK-NEXT: $bc = POP
    ; CHECK: MOV_M $c
    ; CHECK: MOV_M $b
    ; CHECK: $bc = POP
    ; CHECK-NEXT: $a = MOV $c
    STORE_16_ADDR_CONTENT $hl, $hl, implicit-def $hl, implicit-def $a, implicit $sp
    $a = MOV $c
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_sp_hl
body:             |
  bb.0:
    liveins: $sp, $hl

    ; CHECK-LABEL: name:            store16_sp_hl
    ; CHECK-NOT: PUSH $bc
    ; CHECK: PUSH $hl
    ; CHECK-NEXT: $bc = POP
    ; CHECK-NEXT: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: MOV_M $c
    ; CHECK-NEXT: $hl = INX
    ; CHECK-NEXT: MOV_M $b
    ; CHECK-NOT: $bc = POP
    STORE_16_ADDR_CONTENT $sp, $hl, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_sp_hl_preserve_bc
body:             |
  bb.0:
    liveins: $bc, $sp, $hl

    ; CHECK-LABEL: name: store16_sp_hl_preserve_bc
    ; CHECK: PUSH $bc
    ; CHECK-NEXT: PUSH $hl
    ; CHECK-NEXT: $bc = POP
    ; CHECK-NEXT: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK: $bc = POP
    ; CHECK-NEXT: $a = MOV $c
    STORE_16_ADDR_CONTENT $sp, $hl, implicit-def $hl, implicit-def $a, implicit $sp
    $a = MOV $c
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_bc_sp
body:             |
  bb.0:
    liveins: $sp, $bc

    ; CHECK-LABEL: name:            store16_bc_sp
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $a = MOV $l
    ; CHECK-NEXT: STAX $bc
    ; CHECK-NEXT: $bc = INX
    ; CHECK-NEXT: $a = MOV $h
    ; CHECK-NEXT: STAX $bc
    ; CHECK-NEXT: $bc = DCX
    STORE_16_ADDR_CONTENT $bc, $sp, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_hl_sp
body:             |
  bb.0:
    liveins: $sp, $hl

    ; CHECK-LABEL: name:            store16_hl_sp
    ; CHECK-NOT: PUSH $bc
    ; CHECK: PUSH $hl
    ; CHECK-NEXT: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $b = MOV $h
    ; CHECK-NEXT: $c = MOV $l
    ; CHECK-NEXT: $hl = POP
    ; CHECK-NEXT: MOV_M $c
    ; CHECK-NEXT: $hl = INX
    ; CHECK-NEXT: MOV_M $b
    ; CHECK-NOT: $bc = POP
    STORE_16_ADDR_CONTENT $hl, $sp, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_hl_sp_preserve_bc
body:             |
  bb.0:
    liveins: $bc, $sp, $hl

    ; CHECK-LABEL: name: store16_hl_sp_preserve_bc
    ; CHECK: PUSH $bc
    ; CHECK-NEXT: PUSH $hl
    ; CHECK-NEXT: $hl = LXI 4
    ; CHECK-NEXT: DAD $sp
    ; CHECK: $bc = POP
    ; CHECK-NEXT: $a = MOV $c
    STORE_16_ADDR_CONTENT $hl, $sp, implicit-def $hl, implicit-def $a, implicit $sp
    $a = MOV $c
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_sp_sp
body:             |
  bb.0:
    liveins: $sp

    ; CHECK-LABEL: name:            store16_sp_sp
    ; CHECK-NOT: PUSH $bc
    ; CHECK: $hl = LXI 0
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $b = MOV $h
    ; CHECK-NEXT: $c = MOV $l
    ; CHECK-NEXT: MOV_M $c
    ; CHECK-NEXT: $hl = INX
    ; CHECK-NEXT: MOV_M $b
    ; CHECK-NOT: $bc = POP
    STORE_16_ADDR_CONTENT $sp, $sp, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            store16_sp_de_preserve_carry
tracksRegLiveness: true
body:             |
  bb.0:
    successors: %bb.1, %bb.2
    liveins: $de, $sp, $sreg

    ; CHECK-LABEL: name: store16_sp_de_preserve_carry
    ; CHECK: PUSH $psw
    ; CHECK-NEXT: $hl = LXI 2
    ; CHECK-NEXT: DAD $sp
    ; CHECK-NEXT: $psw = POP
    ; CHECK: JC %bb.1, implicit $sreg
    STORE_16_ADDR_CONTENT $sp, $de, implicit-def $hl, implicit-def $a, implicit $sp
    JC %bb.1, implicit $sreg
    JMP %bb.2

  bb.1:
    RET implicit $sp, implicit-def $sp

  bb.2:
    RET implicit $sp, implicit-def $sp
...

---
name:            store8_hl
body:             |
  bb.0:
    liveins: $hl, $c

    ; CHECK-LABEL: name:            store8_hl
    ; CHECK: MOV_M $c, implicit $h, implicit $l
    STORE_8_ADDR_CONTENT $hl, $c, implicit-def $hl, implicit-def $a, implicit $sp
    RET implicit $sp, implicit-def $sp
...

---
name:            frmidx_bc
body:             |
  bb.0:
    liveins: $sp
    ; CHECK-LABEL: name:            frmidx_bc
    ; CHECK: $hl = LXI 6
    ; CHECK: DAD $sp
    ; CHECK: $b = MOV $h
    ; CHECK: $c = MOV $l
    $bc = FRMIDX $sp, 6, implicit-def $sreg, implicit-def $h, implicit-def $l
    RET implicit $sp, implicit-def $sp
...

---
name:            frmidx_hl
body:             |
  bb.0:
    liveins: $sp

    ; CHECK-LABEL: name:            frmidx_hl
    ; CHECK: $hl = LXI 8
    ; CHECK: DAD $sp
    $hl = FRMIDX $sp, 8, implicit-def $sreg, implicit-def $h, implicit-def $l
    RET implicit $sp, implicit-def $sp
...
